# The Waves developer API. Copy to `.env.local`; never commit the filled-in one.
#
# There is no domain name anywhere in this service's code. Its own address is
# derived from the incoming request, and every other address is a variable with
# no fallback, so pointing the whole thing at a different host is this file and
# nothing else. That is the deal MIGRATION.md makes for the rest of Waves, and
# there is no reason a public API should be the exception.

# --------------------------------------------------------------- the backend
# Where PostgREST, GoTrue and the edge functions live. The self-hosted stack in
# infra/self-host/ answers on the same paths, so this is the only line that
# changes when the backend moves.
WAVES_API_SUPABASE_URL=
# Public by design: every table is behind RLS (ADR-013), so this key grants
# nothing on its own. NOT the service-role key -- this service never holds one
# and would have nothing to do with it if it did.
WAVES_API_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------ the keys
# The project's JWT secret (Supabase dashboard -> Project Settings -> API ->
# JWT Secret; on a self-host, GoTrue's GOTRUE_JWT_SECRET). Used for exactly one
# thing: signing a ~60-second `authenticated` JWT for the person a token names,
# so PostgREST applies their row-level security to the request. It never signs a
# service_role token.
WAVES_API_JWT_SECRET=

# Signs this API's own credentials -- personal access tokens, OAuth access and
# refresh tokens, authorization codes. Any long random string; generate one with
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
# Kept separate from the JWT secret so it can be rotated on its own: rotating the
# project's JWT secret signs every Waves user out, which nobody will do to retire
# an API key. Rotating THIS invalidates every issued token at once, which is
# exactly what you want in an incident.
WAVES_API_TOKEN_SECRET=

# ------------------------------------------------------------- the addresses
# Where the OAuth consent screen lives -- the Waves web app. No default: a guess
# here would send somebody approving an application to a domain this deployment
# does not own, so /oauth/authorize refuses until it is set.
#   e.g. https://app.example.com
WAVES_API_WEB_URL=

# Origins allowed to call /developer/* and POST /oauth/authorize from a browser.
# Comma-separated, no trailing slash. Unset means no browser may -- those are
# session-authenticated surfaces, so they fail closed the way the admin console
# does.
#
# Get this wrong and the failure is silent and misleading. A rejected preflight
# is opaque to the page: fetch throws a bare TypeError with no detail, and the
# web app reports it as being offline. Somebody with a perfect connection is told
# they have none, and nothing appears in any log. Check it first when the console
# claims to be offline.
#   e.g. https://app.example.com,http://localhost:3000
WAVES_API_ALLOWED_ORIGINS=

# Optional. This service's own public base URL, for the OAuth issuer and the
# discovery document. Leave blank and it is derived from the request, which is
# right for any deployment behind a normal proxy; set it when a proxy rewrites
# the path or the host header cannot be trusted.
#   e.g. https://api.example.com
WAVES_API_PUBLIC_URL=

# ------------------------------------------------------------- the lifetimes
# All optional; the default is in parentheses. Every one is clamped, so a typo
# cannot turn an hour into a decade.
# WAVES_API_ACCESS_TOKEN_TTL_SECONDS=3600        # (3600) 300 .. 86400
# WAVES_API_REFRESH_TOKEN_TTL_DAYS=90            # (90) 1 .. 365, and never past
#                                                #      app_config.api_token_max_days
# WAVES_API_AUTHORIZATION_CODE_TTL_SECONDS=300   # (300) 30 .. 600
# WAVES_API_USER_JWT_TTL_SECONDS=60              # (60) 15 .. 300

# Rate limits are deliberately NOT here. They are admin knobs in `app_config`
# (api_rate_limit_per_minute, api_rate_limit_per_minute_user), turned from the
# operator console's Limits page and overridable per bucket in
# `rate_limit_rules`. A limit you have to redeploy to change is a limit nobody
# changes during the incident that needed it changed.
