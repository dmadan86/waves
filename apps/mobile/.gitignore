.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local iOS signing credentials. `credentials.json` holds the p12 passwords in
# plain text and `credentials/` the certificates themselves; this repo is
# public. EAS uses remote credentials by default, so neither is needed to build
# — they are a local convenience only.
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase / push credentials. Names a Firebase project, and this repo is
# public — see app.config.ts.
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

.env.local
