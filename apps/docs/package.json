{
  "name": "@waves/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm api:gen && docusaurus start",
    "api:gen": "docusaurus gen-api-docs all",
    "api:clean": "docusaurus clean-api-docs all",
    "build": "pnpm api:gen && docusaurus build",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "typecheck": "tsc --noEmit",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/noto-sans-arabic": "^5.2.5",
    "@fontsource/noto-sans-devanagari": "^5.2.5",
    "@fontsource/noto-sans-tamil": "^5.2.5",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
