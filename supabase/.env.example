# Copy to `supabase/.env` (gitignored) before `supabase start`.
#
# Read by the CLI to fill the `env(...)` placeholders in config.toml. Only
# needed for the local stack — the hosted project keeps its own copy, set
# through the dashboard.

# Google Cloud Console -> APIs & Services -> Credentials -> the Web client whose
# id is in config.toml. This is the secret half of that pair.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Screenshot import (import-screenshot edge function). The model that reads the
# image, via OpenRouter; comma-separated, tried in order. Unset means
# anthropic/claude-haiku-5.5 then google/gemini-3.5-flash. OPENROUTER_API_KEY is
# set on the function, not here.
IMPORT_VISION_MODEL=

# Statement import (parse-statement edge function). Unset STATEMENT_IMPORT_MODEL
# means the same chain as the screenshot import (IMPORT_VISION_MODEL, then the
# defaults). STATEMENT_IMPORT_SIGNING_KEY signs the per-file continuation token;
# unset falls back to the service-role key.
STATEMENT_IMPORT_MODEL=
STATEMENT_IMPORT_SIGNING_KEY=
