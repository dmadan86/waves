# The anon key is public by design: every table is behind RLS (ADR-013), so it
# can only ever read rows the signed-in session is entitled to. Service keys
# belong in edge-function env and nowhere near this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the developer API (apps/api) answers. The console at /developers and the
# OAuth consent screen at /developers/authorize call it from the browser; leave
# it blank and both pages say the developer API is not configured for this
# deployment, rather than failing.
#
# Whatever you put here must also appear in the API's own
# WAVES_API_ALLOWED_ORIGINS -- as the *web* origin, not this value. A missing
# entry there is invisible from the browser: the response is rejected before any
# script can read it, fetch throws a bare TypeError, and this app reports it as
# being offline. Someone with a perfect connection is then told they have none.
NEXT_PUBLIC_WAVES_API_URL=
