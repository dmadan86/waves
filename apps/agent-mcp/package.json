{
  "name": "@waves/agent-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An MCP server that lets an AI agent act inside Waves as a specific signed-in user — create groups, add expenses, and record settlements through the app's own authorized RPCs and edge functions, never raw SQL.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "login": "tsx src/login.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.116.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./oauth": "./src/oauth.ts",
    "./http": "./src/http.ts"
  }
}
