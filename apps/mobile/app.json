{
  "expo": {
    "name": "Waves",
    "slug": "waves",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "waves",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F1FB",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d6e19674-a70b-4385-a925-1884ba5315d8",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.wavs.mobile",
      "appleTeamId": "JBAY4E524Q",
      "associatedDomains": ["applinks:app.wavs.co.in"],
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.wavs.mobile"]
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "app.waves.mobile",
      "allowBackup": false,
      "versionCode": 15,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6C4EE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.wavs.co.in",
              "path": "/join"
            },
            {
              "scheme": "https",
              "host": "app.wavs.co.in",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "app.wavs.co.in",
              "path": "/g"
            },
            {
              "scheme": "https",
              "host": "app.wavs.co.in",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "app.wavs.co.in",
              "pathPrefix": "/r/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [{ "mimeType": "image/*" }],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [{ "mimeType": "image/*" }],
          "category": ["DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withSceneLifecycle",
      "./plugins/withLargeScreenOrientation",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf"
          ]
        }
      ],
      "./plugins/withForegroundOnlyLocation",
      "./plugins/withFirebaseInitFallback",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.3.20",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,Exceptions,SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile\n-keep class expo.modules.wavesstoreupdate.** { *; }\n-keep class expo.modules.waveswatch.** { *; }\n-keep class expo.modules.wavesshare.** { *; }\n-keep class com.google.firebase.FirebaseApp { public static *** getApps(android.content.Context); public static *** initializeApp(android.content.Context); }\n-keep class com.google.mlkit.common.sdkinternal.MlKitContext { public static *** initializeIfNeeded(android.content.Context); }\n-dontwarn com.google.android.play.core.**\n-dontwarn com.google.errorprone.annotations.**\n-dontwarn javax.annotation.**\n-keep class io.github.lukmccall.pika.** { *; }\n-keep class expo.modules.kotlin.records.** { *; }\n-keep class * implements expo.modules.kotlin.records.Record { *; }"
          },
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "@react-native-firebase/auth",
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-quick-actions",
      "./plugins/withShortcutIcons",
      "./plugins/withAnimatedSplashMark",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C4EE3",
          "image": "./assets/images/splash-none.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Waves uses your contacts so you can pick who was there instead of typing their name. Your contacts stay on this phone — only the person you tap is sent."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Waves uses the microphone only while you hold the mic button, to write down what you say. With advanced voice on, the sound is sent to our transcription service and not stored.",
          "speechRecognitionPermission": "Waves turns what you say into the note on an expense, so you can add one without typing at the table.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false,
          "iosConfig": {
            "microphoneUsageDescription": "Waves uses the microphone only while you hold the mic button, to write down what you say. With advanced voice on, the sound is sent to our transcription service and not stored."
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Waves uses the camera to scan a bill, so the total and the items come out filled in instead of typed. The photo is uploaded to Waves and read by an AI service."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Waves uses the camera to scan a group's invite QR code, so you can join without typing the link, and to photograph a receipt to attach to an expense."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Waves attaches where you are to a new expense, so you can remember where you spent. You can remove it before saving. Location is read only while you use the app, never in the background.",
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withShortNativeBuildPath",
      "./plugins/withGradleMemory",
      "./plugins/withHermesHeaders",
      "./plugins/withSideBySideDebug",
      "./plugins/withEdgeToEdgeTheme",
      "./plugins/withReleaseSigning",
      "./plugins/withSmsReader",
      "./plugins/withWavesWidgets",
      "./plugins/withWavesWear",
      "@bacons/apple-targets",
      "expo-secure-store",
